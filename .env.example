# Django local development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# SMSGate Android SMS Gateway - Cloud Server credentials
# Find these in the SMSGate Android app under Cloud Server settings.
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# Optional: select a specific registered Android device. Leave blank for default routing.
SMSGATE_DEVICE_ID=
# Optional SIM slot number (for example 1). Leave blank for default SIM.
SMSGATE_SIM_NUMBER=
SMSGATE_BASE_URL=https://api.sms-gate.app
